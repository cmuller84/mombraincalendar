# --- Database ---------------------------------------------------------------
# SQLite file, relative to the prisma/ directory. Good enough for a family app.
DATABASE_URL="file:./dev.db"

# --- AI event parsing (Claude) ----------------------------------------------
# Get a key at https://console.anthropic.com  (costs ~pennies per event parsed)
ANTHROPIC_API_KEY=""
# Optional override; defaults to a fast, inexpensive model.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Push notifications (free) ----------------------------------------------
# Generate a keypair once with:  npx web-push generate-vapid-keys
# Then paste the values here. The public key is also exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- SMS reminders (optional, paid) -----------------------------------------
# Leave blank to disable SMS. Sign up at https://twilio.com and buy a number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Reminder dispatcher ----------------------------------------------------
# A shared secret so only your cron job can trigger reminder sending.
CRON_SECRET="change-me-to-a-long-random-string"

# Default timezone for interpreting natural-language dates ("next Friday").
DEFAULT_TIMEZONE="America/New_York"
